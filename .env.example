# Backend
BACKEND_PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Mobile
REACT_APP_API_URL=http://localhost:5000/api

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx

# SMS (Twilio)
TWILIO_ACCOUNT_SID=AC_xxx
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1234567890

# Storage (Supabase Storage S3 API)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=eu-west-1
AWS_S3_BUCKET=nancy-motorcycle-spares-product-images
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/nancy-motorcycle-spares-product-images

# Logistics (Kenya Post / Jambopay)
LOGISTICS_API_KEY=your_key
LOGISTICS_API_URL=https://api.logistics-provider.com
