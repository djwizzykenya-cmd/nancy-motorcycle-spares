BACKEND_PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/nancy_motorcycle_spares
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# Email service
# SENDGRID_API_KEY=

# SMS service
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=nancy-motorcycle-spares-product-images
# Supabase Storage S3 endpoint (replace the project ref for another project)
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# Required public bucket or CDN base URL
AWS_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/nancy-motorcycle-spares-product-images
